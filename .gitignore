# Secrets and local environments.
# .env.example is the only environment file that belongs in git.
.env
.env.*
*.env
!.env.example
!**/.env.example
!*.env.example

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/
ENV/

# Node and frontend build output
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Databases and local audio
*.sqlite
*.sqlite3
*.db
backend/*.db
audio_cache/
*.mp3

# Editors and operating systems
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db
.cursorrules
