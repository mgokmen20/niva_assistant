# Copy this file to .env and replace the placeholders.
# Do not put real tokens, passwords, or connection strings in this example.

# Cloudflare Workers AI. Leave both blank to use the local summary fallback.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# JWT signing. At least 32 characters, and not this placeholder.
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Async database URL. The app expects the postgresql+asyncpg driver.
DATABASE_URL=postgresql+asyncpg://niva:replace-with-a-password@localhost:5432/niva

# Optional forecast host. The public Open-Meteo URL is used when this is empty.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Staff seed only (python -m scripts.seed_staff). Not required to start the API.
NIVA_ADMIN_EMAIL=admin@example.com
NIVA_ADMIN_PASSWORD=replace-with-a-password
NIVA_PARTNER_EMAIL=partner@example.com
NIVA_PARTNER_PASSWORD=replace-with-a-password
